// GTQC — site public gtqc.net (Worker « gtqc », relié au dépôt GitHub : déployé à chaque Push).
// Le Worker (site/worker.js) passe en premier et ne sert que maquette/ et assets/.
{
  "name": "gtqc",
  "main": "site/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "gtqc.net", "custom_domain": true },
    { "pattern": "www.gtqc.net", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
